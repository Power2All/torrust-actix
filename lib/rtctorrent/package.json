{
  "name": "rtctorrent",
  "version": "4.2.0",
  "description": "WebRTC-enabled BitTorrent client library",
  "main": "src/rtctorrent.js",
  "module": "src/rtctorrent.js",
  "browser": "dist/rtctorrent.browser.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "serve": "node bin/serve.js",
    "test": "jest",
    "test:transfer": "node test/test_webrtc_transfer.js",
    "test:signaling": "node test/test_signaling_flow.js",
    "test:create": "node test/create_torrent.js -- <file>",
    "test:seed": "node test/seed_torrent.js",
    "test:leech": "node test/leech_torrent.js"
  },
  "keywords": [
    "bittorrent",
    "webrtc",
    "p2p",
    "torrent",
    "webtorrent",
    "rtctorrent"
  ],
  "author": "Torrust Team",
  "license": "MIT",
  "dependencies": {
    "bencode": "^2.0.3",
    "graceful-fs": "^4.2.11",
    "js-yaml": "^5.2.3",
    "simple-sha1": "^3.1.0"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "^0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-loader": "^10.1.1",
    "buffer": "^6.0.3",
    "jest": "^30.4.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "engines": {
    "node": ">=12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/torrust/torrust-actix.git"
  }
}
