+++ b/src/tracker/structs/torrent_counts.rs
@@ -0,0 +1,37 @@
+use crate::tracker::structs::torrent_entry::TorrentEntry;
+
+/// Cheap snapshot of a [`TorrentEntry`] for scrape responses.
+///
+/// Holds just the lengths of each peer map and the `completed` count, so
+/// scrape can answer without cloning the underlying `AHashMap<PeerId,
+/// TorrentPeer>` maps that `TorrentEntry::clone` would copy.
+#[derive(Clone, Copy, Debug)]
+pub struct TorrentCounts {
+    pub seeds_ipv4: usize,
+    pub seeds_ipv6: usize,
+    pub peers_ipv4: usize,
+    pub peers_ipv6: usize,
+    pub completed: u64,
+}
+
+impl TorrentCounts {
+    pub fn from_entry(entry: &TorrentEntry) -> Self {
+        Self {
+            seeds_ipv4: entry.seeds.len(),
