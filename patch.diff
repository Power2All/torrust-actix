+/// Stack-allocated hex buffer for serialising 20-byte ids (info_hash,
+/// peer_id, user_id).  Use [`Hex20::as_str`] to borrow the contents as
+/// `&str`.  The single `unsafe` block is contained here, in one place,
+/// rather than repeated at each `Serialize` impl.
+pub struct Hex20(pub [u8; 40]);
+
+impl Hex20 {
+    #[inline]
+    pub fn as_str(&self) -> &str {
+        // SAFETY: `bin20_to_hex` only writes ASCII hex digits ('0'-'9',
+        // 'a'-'f') from the constant table below, so the buffer is always
+        // valid UTF-8.
+        unsafe { std::str::from_utf8_unchecked(&self.0) }
+    }
+}
+
+#[inline]
+pub fn bin20_to_hex(data: &[u8; 20]) -> Hex20 {
+    const HEX_CHARS: &[u8; 16] = b"0123456789abcdef";
+    let mut buffer = [0u8; 40];
+    for (i, &byte) in data.iter().enumerate() {
+        let idx = i * 2;
+        buffer[idx] = HEX_CHARS[(byte >> 4) as usize];
+        buffer[idx + 1] = HEX_CHARS[(byte & 0xf) as usize];
+    }
+    Hex20(buffer)
+}
